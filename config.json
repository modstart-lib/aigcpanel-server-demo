{
  "name": "server-demo",
  "version": "1.1.0",
  "title": "示例模型（队列模式）",
  "description": "模型描述",
  "deviceDescription": "设备描述",
  "platformName": "osx",
  "platformArch": "arm64",
  "serverRequire": "*",
  "mode": {
    "type": "watch",
    "watchDelay": 60
  },
  "entry": "__EasyServer__",
  "launcher": {
    "entry": "./_aienv/bin/python",
    "entryArgs": [
      "-u",
      "-m",
      "run",
      "${CONFIG}"
    ],
    "envs": [
      "AAA=111",
      "BBB=222"
    ]
  },
  "easyServer": {
    "entry": "./_aienv/bin/python",
    "entryArgs": [
      "run.py",
      "${CONFIG}"
    ],
    "envs": []
  },
  "functions": [
    "videoGen",
    "soundTts",
    "soundClone",
    "asr",
    "textToImage",
    "imageToImage",
    "textToVideo",
    "imageToVideo",
    "general"
  ],
  "settings": [],
  "general": [
    {
      "name": "generalImage",
      "title": "通用图片生成（示例）",
      "description": "演示通用模型：接收任意参数（prompt/count），输出多张图片 + 文字说明 + 附加文件。",
      "param": [
        {
          "name": "prompt",
          "title": "提示词",
          "type": "textarea",
          "defaultValue": "一张星空下的山脉"
        },
        {
          "name": "count",
          "title": "生成数量",
          "type": "number",
          "defaultValue": 2,
          "min": 1,
          "max": 5,
          "step": 1
        }
      ],
      "result": [
        {
          "type": "file",
          "name": "image",
          "title": "封面图片"
        },
        {
          "type": "files",
          "name": "images",
          "title": "生成图片"
        },
        {
          "type": "text",
          "name": "text",
          "title": "附加说明"
        },
        {
          "type": "files",
          "name": "files",
          "title": "附加文件"
        }
      ]
    }
  ]
}
